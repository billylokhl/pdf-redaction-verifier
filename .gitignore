__pycache__/
*.py[cod]
.venv/
venv/
.DS_Store
*.egg-info/
build/
dist/
.coverage
# Hypothesis's example database (the local `dev` profile, tests/conftest.py).
.hypothesis/

# Local agent worktrees and settings
.claude/

# The real-world corpus manifest and results are local-only: SHA-256s
# and (locally meaningful) relative paths into a directory of real files
# that never leaves this machine (docs/REDESIGN.md §5, Phase 0c).
/eval/scorecard/real_corpus/

# The real-redactor set's local stratum (eval/redactor_set): generated
# inputs, the redaction tool's outputs, oracle evidence and adjudication.
# All fabricated, but local by design: large, partly non-deterministic, and
# the same layout will one day hold real documents (eval/README.md).
/eval/scorecard/redactor_set_local/

# The scorecard's local reference-result cache (--cache-dir), the same
# default path CI's actions/cache step restores into.
/eval/scorecard/.reference-cache/

# The gallery (eval/gallery, docs/REDESIGN.md's Phase 0e) is rebuilt fresh
# every time from the case library: generated HTML and page-1 PNGs, never
# committed.
/eval/gallery/_build/

